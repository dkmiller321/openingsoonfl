# Production .env: copy to .env on the server and fill every blank. Never commit it.

# --- Domain (Caddy gets the HTTPS certificate for this) ---
DOMAIN=app.openingsoonfl.com
APP_BASE_URL=https://app.openingsoonfl.com

# --- Database ---
POSTGRES_USER=osfl
POSTGRES_PASSWORD=
POSTGRES_DB=osfl
# The app container overrides the host to "postgres"; keep the same password here.
DATABASE_URL=postgresql+psycopg://osfl:CHANGE-TO-POSTGRES_PASSWORD@postgres:5432/osfl

# --- Admin ---
ADMIN_PASSWORD=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Operator ---
OPERATOR_EMAIL=
OPERATOR_POSTAL_ADDRESS=

# --- Sources (real DBPR data) ---
SOURCE_MODE=live
COUNTIES=brevard
FETCH_USER_AGENT=OpeningSoonFL/1.0 (+mailto:you@openingsoonfl.com)
FETCH_MIN_INTERVAL_S=2
GEOCODER_MODE=live

# --- Email (Resend) ---
EMAIL_MODE=resend
RESEND_API_KEY=
EMAIL_FROM=OpeningSoon FL <leads@openingsoonfl.com>

# --- Map ---
MAPBOX_TOKEN=

# --- Vendors / scheduler ---
MAX_VENDORS_PER_CATEGORY=3
SCHEDULER_ENABLED=1
SCHEDULER_TIMEZONE=America/New_York
TEST_ROUTES=0

# --- Host ports (Compose) ---
APP_HOST_PORT=8010
POSTGRES_HOST_PORT=55433

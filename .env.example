# Copy to .env. Read once at startup by osfl/settings.py (pydantic-settings, fail-fast).
# Use 127.0.0.1, never localhost (on Windows, localhost costs ~10 s per Postgres connection).

# --- Database ---
POSTGRES_USER=osfl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osfl
# Compose publishes Postgres on 127.0.0.1:55433. Inside Compose the app uses host "postgres".
DATABASE_URL=postgresql+psycopg://osfl:change-me@127.0.0.1:55433/osfl
# Used by the e2e live_server fixture (port 8001). Created in stage 0.
TEST_DATABASE_URL=postgresql+psycopg://osfl:change-me@127.0.0.1:55433/osfl_test
# Used only by the playwright-headless walkthrough server (port 8002). Never shared with pytest.
WALK_DATABASE_URL=postgresql+psycopg://osfl:change-me@127.0.0.1:55433/osfl_walk

# --- Admin ---
# Required. The app refuses to start without it. Use a long random value in production.
ADMIN_PASSWORD=change-me
# Required. Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=dev-only-change-me

# --- Operator details (appear in digests and alerts) ---
OPERATOR_EMAIL=operator@example.com
# Required by CAN-SPAM in every digest footer. Put your real mailing address here before sending to vendors.
OPERATOR_POSTAL_ADDRESS=OpeningSoon FL, PO Box 1000, Melbourne, FL 32901
# Public base URL used in unsubscribe links.
APP_BASE_URL=http://127.0.0.1:8010

# --- Sources ---
# fixture = replay files in fixtures/ (default; no network). live = real DBPR.
SOURCE_MODE=fixture
# DBPR public-record downloads (found in the stage 0 spike, docs/DECISIONS.md D1).
DBPR_NEWFOOD_URL=https://www2.myfloridalicense.com/sto/file_download/extracts/newfood.csv
DBPR_CHGOWNR_URL=https://www2.myfloridalicense.com/sto/file_download/extracts/chgownr_food.csv
DBPR_PLAN_REVIEW_URL=https://www2.myfloridalicense.com/sto/file_download/extracts/HR_plan_review.csv
# Counties to ingest. v1 = brevard only.
COUNTIES=brevard
# Identifies us to DBPR. Put a real contact email here.
FETCH_USER_AGENT=OpeningSoonFL/0.1 (+mailto:operator@example.com)
# Minimum seconds between requests to a government site (I5). Don't lower it.
FETCH_MIN_INTERVAL_S=2

# --- Email ---
# outbox = write to the outbox table (default; tests). resend = send via Resend.
EMAIL_MODE=outbox
# Needed only when EMAIL_MODE=resend. Create at resend.com and verify your sending domain first.
RESEND_API_KEY=
# Must be on your Resend-verified domain, e.g. "OpeningSoon FL <leads@yourdomain.com>".
EMAIL_FROM=

# --- Vendors ---
# V3 warning threshold: active vendors per category per county.
MAX_VENDORS_PER_CATEGORY=3

# --- Scheduler ---
# 1 = run the 5 jobs on their ET schedule. Tests and the walkthrough set 0.
SCHEDULER_ENABLED=1
SCHEDULER_TIMEZONE=America/New_York

# --- Testing ---
# 1 = mount /test/* routes (reset, clock, run, outbox...). Never set in production.
TEST_ROUTES=0
# Optional frozen clock, ISO-8601 UTC, e.g. 2026-09-07T11:00:00Z. Blank = real time.
FAKE_NOW=
# 1 = allow the live-DBPR @smoke suite to run.
RUN_SMOKE=0

# --- Server ---
# Dev server (uvicorn on the host). The Compose app is published on APP_HOST_PORT.
HOST=127.0.0.1
PORT=8003
# Host ports for Docker Compose (8000/55432 are taken by LaunchLedger on this machine; DECISIONS D5).
APP_HOST_PORT=8010
POSTGRES_HOST_PORT=55433

# --- Map ---
# Mapbox public token (pk.*) for basemap tiles (account.mapbox.com/access-tokens). Blank = OpenStreetMap fallback.
# Restrict it to your domain in the Mapbox account. Never commit a real token.
MAPBOX_TOKEN=
